{
    "name": "website",
    "version": "0.1.0",
    "private": true,
    "scripts": {
        "dev": "npm run build-docs && next dev",
        "build": "next build",
        "start": "next start",
        "lint": "next lint",
        "build-docs": "npm run prepare-for-build-api-docs && node scripts/generate-api-docs.mjs && node scripts/generate-backend-docs.js && node scripts/generate-frontend-docs.mjs",
        "prepare-for-build-api-docs": "cd ../backend && dotnet build -c Release && dotnet tool restore && dotnet swagger tofile --output ../docs/swagger.json bin/Release/net9.0/backend.dll v1 && cd ../docs"
    },
    "dependencies": {
        "@radix-ui/react-collapsible": "^1.1.4",
        "@radix-ui/react-navigation-menu": "^1.2.5",
        "@radix-ui/react-slot": "^1.2.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "fumadocs-core": "^16.7.6",
        "fumadocs-mdx": "^14.2.11",
        "fumadocs-openapi": "^10.5.0",
        "fumadocs-ui": "^16.4.4",
        "glob": "^13.0.6",
        "lucide-react": "^1.7.0",
        "next": "^16.2.1",
        "react": "19.2.4",
        "react-dom": "19.2.4",
        "react-syntax-highlighter": "^16.1.1",
        "refractor": "^5.0.0",
        "shiki": "^4.0.2",
        "tailwind-merge": "^3.0.2",
        "tailwindcss-animate": "^1.0.7",
        "typedoc-plugin-markdown": "^4.11.0"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3",
        "@fumadocs/cli": "^1.3.2",
        "@tailwindcss/postcss": "^4.2.2",
        "@types/mdx": "^2.0.13",
        "@types/node": "^25",
        "@types/react": "19.2.14",
        "@types/react-dom": "19.2.3",
        "eslint": "^10",
        "eslint-config-next": "16.2.1",
        "postcss": "^8.5.8",
        "prettier": "^3.8.1",
        "prettier-plugin-tailwindcss": "^0.7.2",
        "tailwindcss": "^4.0.9",
        "typescript": "^6"
    },
    "overrides": {
        "@types/react": "19.2.14",
        "@types/react-dom": "19.2.3",
        "prismjs": "1.30.0"
    }
}
